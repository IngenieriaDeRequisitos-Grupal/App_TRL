{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": { "tsConfigPath": "apps/gateway/tsconfig.app.json" }
    },
    "users-service": {
      "type": "application",
      "root": "apps/users-service",
      "entryFile": "main",
      "sourceRoot": "apps/users-service/src",
      "compilerOptions": { "tsConfigPath": "apps/users-service/tsconfig.app.json" }
    },
    "requests-service": {
      "type": "application",
      "root": "apps/requests-service",
      "entryFile": "main",
      "sourceRoot": "apps/requests-service/src",
      "compilerOptions": { "tsConfigPath": "apps/requests-service/tsconfig.app.json" }
    },
    "telemetry-service": {
      "type": "application",
      "root": "apps/telemetry-service",
      "entryFile": "main",
      "sourceRoot": "apps/telemetry-service/src",
      "compilerOptions": { "tsConfigPath": "apps/telemetry-service/tsconfig.app.json" }
    },
    "clinical-service": {
      "type": "application",
      "root": "apps/clinical-service",
      "entryFile": "main",
      "sourceRoot": "apps/clinical-service/src",
      "compilerOptions": { "tsConfigPath": "apps/clinical-service/tsconfig.app.json" }
    },
    "integration-service": {
      "type": "application",
      "root": "apps/integration-service",
      "entryFile": "main",
      "sourceRoot": "apps/integration-service/src",
      "compilerOptions": { "tsConfigPath": "apps/integration-service/tsconfig.app.json" }
    },
    "finance-service": {
      "type": "application",
      "root": "apps/finance-service",
      "entryFile": "main",
      "sourceRoot": "apps/finance-service/src",
      "compilerOptions": { "tsConfigPath": "apps/finance-service/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    }
  }
}
