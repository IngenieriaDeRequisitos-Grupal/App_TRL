NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

POSTGRES_ADMIN_PASSWORD=replace-with-admin-database-password
POSTGRES_APP_PASSWORD=replace-with-separate-app-database-password

DATABASE_URL=postgresql://trl_app:replace-me@postgres:5432/trl_db
DB_SSL=false

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=trl-backend
JWT_AUDIENCE=trl-app
JWT_ACCESS_TTL_SECONDS=3600
JWT_MFA_TTL_SECONDS=300
MFA_CONSOLE_OUTPUT=false

PASSWORD_PEPPER=replace-with-an-independent-random-secret
FIELD_ENCRYPTION_KEY_BASE64=replace-with-32-byte-key-encoded-as-base64
AUDIT_HMAC_KEY=replace-with-an-independent-random-secret

TERMS_VERSION=1.0.0
PRIVACY_NOTICE_VERSION=1.0.0
MAX_EVIDENCE_BYTES=10485760

# Solo para `npm run seed`; elimínelos del entorno después del bootstrap.
SEED_ADMIN_NAME=Administrador TRL
SEED_ADMIN_CEDULA=1100000000
SEED_ADMIN_EMAIL=admin@example.edu.ec
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password
