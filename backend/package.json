{
  "name": "medapp-backend",
  "version": "1.0.0",
  "description": "Backend de microservicios - Sistema de Atencion Medica Remota",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build gateway && nest build users-service && nest build requests-service && nest build telemetry-service && nest build clinical-service && nest build integration-service && nest build finance-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "start:gateway": "nest start gateway",
    "start:users": "nest start users-service",
    "start:requests": "nest start requests-service",
    "start:telemetry": "nest start telemetry-service",
    "start:clinical": "nest start clinical-service",
    "start:integration": "nest start integration-service",
    "start:finance": "nest start finance-service",
    "start:gateway:dev": "nest start gateway --watch",
    "start:users:dev": "nest start users-service --watch",
    "start:requests:dev": "nest start requests-service --watch",
    "start:telemetry:dev": "nest start telemetry-service --watch",
    "start:clinical:dev": "nest start clinical-service --watch",
    "start:integration:dev": "nest start integration-service --watch",
    "start:finance:dev": "nest start finance-service --watch",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/typeorm": "^10.0.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.4",
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
